
<!DOCTYPE html>
<html lang="en">
<head>
<title>Student Academic Dashboard</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #333;
}

/* Top Navigation */
.navbar {
    background: #172554;
    padding: 18px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.navbar h2 {
    color: #60a5fa;
}

.navbar ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
}

.navbar ul li a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: bold;
}

.navbar ul li a:hover {
    color: #60a5fa;
}

/* Main Container */
.main {
    padding: 30px 5%;
}

/* Header */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 25px;
}

.header h1 {
    color: #172554;
}

.header p {
    color: #64748b;
    margin-top: 6px;
}

/* Student Profile */
.profile {
    background: white;
    padding: 22px;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 25px;
    box-shadow: 0 2px 8px #00000010;
}

.profile h3 {
    color: #2563eb;
    margin-bottom: 10px;
}

.profile p {
    margin: 7px 0;
    color: #555;
}

/* Dashboard Cards */
.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 25px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 2px 8px #00000010;
    border-top: 4px solid #2563eb;
}

.card h3 {
    color: #64748b;
    font-size: 15px;
    margin-bottom: 12px;
}

.card h2 {
    color: #2563eb;
    font-size: 30px;
}

.card p {
    margin-top: 8px;
    color: #64748b;
}

/* Sections */
.section {
    background: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 25px;
    box-shadow: 0 2px 8px #00000010;
    overflow-x: auto;
}

.section h2 {
    color: #172554;
    margin-bottom: 20px;
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
    min-width: 500px;
}

th, td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid #e2e8f0;
}

th {
    background: #dbeafe;
    color: #172554;
}

tr:hover {
    background: #f8fafc;
}

/* Attendance */
.attendance-item {
    margin-bottom: 22px;
}

.attendance-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

.progress {
    height: 12px;
    background: #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: #2563eb;
    border-radius: 10px;
}

.green {
    background: #16a34a;
}

.orange {
    background: #f59e0b;
}

/* Announcements */
.announcement {
    padding: 16px;
    margin-bottom: 15px;
    background: #eff6ff;
    border-left: 5px solid #2563eb;
    border-radius: 7px;
}

.announcement h3 {
    color: #1d4ed8;
    margin-bottom: 8px;
}

.announcement p {
    color: #475569;
    line-height: 1.5;
}

/* Footer */
footer {
    background: #172554;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Responsive Design */
@media(max-width: 850px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .navbar {
        justify-content: center;
    }

    .navbar ul {
        justify-content: center;
    }
}

@media(max-width: 600px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .navbar {
        flex-direction: column;
    }

    .navbar ul {
        gap: 12px;
    }

    .navbar ul li a {
        font-size: 12px;
    }

    .main {
        padding: 18px;
    }

    .header {
        align-items: flex-start;
    }
}
</style>
</head>

