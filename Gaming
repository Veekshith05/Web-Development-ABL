            padding: 15px;
        }
        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }
        section {
            text-align: center;
            padding: 20px;
        }
        .card {
            display: inline-block;
            background: #292929;
            width: 220px;
            margin: 15px;
            padding: 15px;
            border-radius: 10px;
        }
        .card img {
            width: 100%;
            height: 140px;
            border-radius: 10px;
